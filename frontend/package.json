{
  "name": "policy-diff-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke": "esbuild scripts/smoke-entry.ts --bundle --outfile=scripts/.build/smoke.mjs --platform=node --format=esm --log-level=warning && node scripts/.build/smoke.mjs",
    "check:ssr": "esbuild scripts/ssr-check.ts --bundle --outfile=scripts/.build/ssr-check.mjs --platform=node --format=esm --log-level=warning --packages=external && node scripts/.build/ssr-check.mjs",
    "check:review": "esbuild scripts/ssr-review.ts --bundle --outfile=scripts/.build/ssr-review.mjs --platform=node --format=esm --log-level=warning --packages=external && node scripts/.build/ssr-review.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "element-plus": "^2.8.1",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vue-tsc": "^2.0.29"
  }
}
